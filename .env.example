# SalonSniper Configuration - Development

# Helius API Configuration
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
HELIUS_SECURE_RPC=https://your-secure-endpoint.helius-rpc.com
HELIUS_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
HELIUS_PARSE_TX=https://api.helius.xyz/v0/transactions/?api-key=YOUR_API_KEY
HELIUS_TX_HISTORY=https://api.helius.xyz/v0/addresses/{address}/transactions/?api-key=YOUR_API_KEY

# Listener Configuration - Stage 2 Optimized for 15 tokens/minute
BATCH_WINDOW_MS=2000
DEDUP_TTL_S=60
REST_FALLBACK_LIMIT_PER_SEC=1
MAX_BATCH_SIZE=25
MAX_BACKLOG_EVENTS=5000
WS_RECONNECT_MAX_DELAY_S=60
MAX_TOKEN_AGE_HOURS=1.5
PROCESSING_DELAY_MS=1000
INTER_BATCH_DELAY_MS=3000

# Stage 3 Filter Configuration
DEDUP_TTL_MS=30000
FILTER_PIPELINE_ENABLED=true
FILTER_SCORE_THRESHOLD=0.0

# Step 3.1 - Dedup Filter (DISABLED - duplicates Stage 2)
DEDUP_FILTER_ENABLED=false

# Step 3.2 - Sanity Filter (DISABLED - duplicates Stage 2)
SANITY_FILTER_ENABLED=false
SANITY_CRITICAL=false
SANITY_TIMEOUT_MS=300
SANITY_MIN_DECIMALS=0
SANITY_MAX_DECIMALS=18
SANITY_MAX_RETRIES=3
SANITY_BATCH_SIZE=100
SANITY_BATCH_TIMEOUT_MS=500

# Step 3.3 - Renounced Filter (FIRST REAL FILTER)
RENOUNCED_FILTER_ENABLED=true
RENOUNCED_CRITICAL=false
RENOUNCED_TIMEOUT_MS=1000
RENOUNCED_REQUIRE_MINT_RENOUNCED=true
RENOUNCED_REQUIRE_FREEZE_RENOUNCED=false
RENOUNCED_PENALTY_NOT_RENOUNCED=-0.5
RENOUNCED_BONUS_RENOUNCED=0.3

# Step 3.4 - Mutable Filter (SECOND REAL FILTER)
MUTABLE_FILTER_ENABLED=true
MUTABLE_CRITICAL=false
MUTABLE_TIMEOUT_MS=1000
MUTABLE_PENALTY_MUTABLE=-0.3
MUTABLE_BONUS_IMMUTABLE=0.2
MUTABLE_PENALTY_BLACKLISTED_AUTHORITY=-1.0
MUTABLE_BONUS_SOCIAL_LINKS=0.1

# Step 3.5 - LocalRouteGate Filter (Jupiter Quote API)
ROUTE_GATE_FILTER_ENABLED=true
ROUTE_GATE_CRITICAL=false
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_QUOTE_AMOUNT_SOL=0.05
JUPITER_MAX_PRICE_IMPACT_BPS=600
JUPITER_REQUEST_TIMEOUT_MS=3000
JUPITER_RETRIES=2
JUPITER_REQUEST_CONCURRENCY=3
JUPITER_REQUEST_DELAY_MS=150
POOLGATE_MODE=BLOCKING
JUPITER_CACHE_TTL_S=30
JUPITER_BACKOFF_BASE_MS=200

# Step 3.6 - LP Protection Filter (DEX-aware with Jupiter integration)
LP_PROTECTION_ENABLED=true
LP_PROTECTION_MODE=SAFE
LP_TOP1_MAX=50
LP_TOP5_MAX=80
LP_BURN_MIN_PCT=80
LP_LOCKER_WHITELIST=11111111111111111111111111111111,TeamTokenLockupContract11111111111111,UnicryptLockContract1111111111111111,PinkLockContract111111111111111111111

LP_PI_TEST_AMOUNTS=0.02,0.5
LP_PI_DELTA_MAX_BPS=500

JUP_BASE_URL=https://lite-api.jup.ag
JUP_QUOTE_PATH=/swap/v1/quote
JUP_OUTPUT_MINT=So11111111111111111111111111111111111111112
JUP_SLIPPAGE_BPS=50
JUP_RATE_LIMIT_RPS=2
JUP_CONCURRENCY=2
JUP_CACHE_TTL_MS=60000
JUP_TIMEOUT_MS=2500
JUP_RETRY=2

# Step 3.7 - Pool Size/Activity Filter (Jupiter-based EL measurement)
POOL_SIZE_ENABLED=true
POOL_SIZE_CRITICAL=false

# Jupiter configuration (shared with 3.5 and 3.6)
JUP_BASE_URL=https://lite-api.jup.ag
JUP_QUOTE_PATH=/swap/v1/quote
JUP_OUTPUT_MINT=So11111111111111111111111111111111111111112
JUP_SLIPPAGE_BPS=50
JUP_TARGET_PI_BPS=600
JUP_QPS_MAX=3
JUP_CONCURRENCY=2
JUP_CACHE_TTL_MS=60000
JUP_TIMEOUT_MS=2500
JUP_RETRY=1

# EL search configuration
EL_SMALL_SOL=0.02
EL_BIG_SOL=0.5
EL_MAX_STEPS=3
MIN_EL_SOL=0.2

# Volume check (optional, disabled by default)
V_CHECK_ENABLED=false
V_WINDOW_MIN=5
V_MAX_TX=80
V_MIN_SWAPS=3

# Helius for volume (if enabled)
HELIUS_RPS_MAX=3
HELIUS_TIMEOUT_MS=1200

# Step 3.8 - Holder Distribution Filter
HOLDERS_ENABLED=true
HOLDERS_CRITICAL=true
HOLDERS_MODE=LOG_ONLY
HOLDERS_CACHE_TTL_MS=60000
HOLDERS_RPC_TIMEOUT_MS=2500
HOLDERS_CONCURRENCY=4
HOLDERS_RATE_LIMIT_QPS=10
HOLDERS_TOP_N=20
HOLDERS_TOP1_MAX_PCT=5
HOLDERS_TOP5_MAX_PCT=10
HOLDERS_TOP10_MAX_PCT=20
HOLDERS_TEAM_MAX_PCT=15
HOLDERS_NEW_WALLETS_WARN_PCT=40
HOLDERS_NEW_WALLETS_FAIL_PCT=60
HOLDERS_NEW_WALLET_AGE_DAYS=7
HOLDERS_VERIFY_TX_HISTORY=true

# Logging Configuration
LOG_LEVEL=debug
NODE_ENV=development
DEBUG=salonsniper:*
